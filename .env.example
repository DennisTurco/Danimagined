# Progetto Sanity (sanity.io/manage → progetto → Project ID)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Segreto condiviso con il webhook di Sanity che aggiorna il sito a ogni pubblicazione
SANITY_REVALIDATE_SECRET=

# Google Search Console → Aggiungi proprietà → Tag HTML: solo il valore di content="..."
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# EmailJS (dashboard.emailjs.com) per il form contatti. Senza, il form apre l'app di posta.
# Template: oggetto {{subject}}, Reply-To {{email}}, corpo con {{name}}, {{email}} e {{message}}.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
